# Supabase (local defaults are printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app (used in request and invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random string used to hash IP addresses before storing them
IP_HASH_SALT=change-me

# Largest video upload in MB. Supabase's free plan caps uploads at 50 MB; use 100 on a paid plan
# (and raise the `uploads` bucket limit to match).
NEXT_PUBLIC_VIDEO_MAX_MB=50

# Super admin bootstrap (used only by `npm run seed:admin`)
SUPER_ADMIN_EMAIL=admin@example.test
SUPER_ADMIN_PASSWORD=

# Optional: demo owner for `npm run seed:demo` (local stack only). Leave the password empty to generate one.
DEMO_OWNER_EMAIL=owner@demo.test
DEMO_OWNER_PASSWORD=
